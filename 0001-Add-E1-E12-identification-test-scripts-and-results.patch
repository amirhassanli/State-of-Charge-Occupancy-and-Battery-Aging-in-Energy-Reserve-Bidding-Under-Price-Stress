+++ b/code/e_tests/e08_scan_no_reserve_revenue.py
@@ -0,0 +1,31 @@
+"""E8 - 20-day scan (min DA < -20) with reserve REVENUE set to zero in P1 (lambda_R = 0): isolates how much of P1-B2
+is just 'reserve price > 0'. Also writes the baseline scan used by E9."""
+import pandas as pd, numpy as np
+from common import *
+class zero_reserve:
+    def __enter__(s): s.old = core.reserve_prices; core.reserve_prices = lambda: (np.zeros(24), np.zeros(24))
+    def __exit__(s, *a): core.reserve_prices = s.old
+def scan(K=20, below=-20.0, tl=60, with_zero=False):
+    df, cols = load_panel(PANEL); days, M = daily_matrices(df, cols); pl = plant(); rows = []
+    for i, d in enumerate(days):
+        if np.nanmin(M["price"][i]) >= below: continue
+        r = scenarios_for_day(M, i, K, np.random.default_rng(SEED+i))
+        if r is None: continue
+        sc, real = r; row = dict(day=str(d), min_price=float(real["lam"].min()))
+        for law in LAWS:
+            try:
+                g, o = gap(pl, sc, real, law, tl=tl); row[f"gap_{law}"] = g
+                row[f"aFRR_{law}"] = o["P1"]["aFRR"]; row[f"energy_side_{law}"] = g - o["P1"]["aFRR"]   # gap minus reserve revenue
+                if with_zero:
+                    with zero_reserve(): row[f"gap0_{law}"] = gap(pl, sc, real, law, tl=tl)[0]
+            except RuntimeError as e: print("skip", d, law, e)
+        rows.append(row)
+    return pd.DataFrame(rows)
+def main(K=20, with_zero=False, tol=1.0):
+    """tol: a gap counts as a reversal only if < -tol EUR (guards against 1e-9 numerical noise)."""
+    X = scan(K, with_zero=with_zero); save(X, "E08_scan"); n = len(X)
+    for law in LAWS:
+        print(law, "reversals", int((X[f"gap_{law}"] < -tol).sum()), "/", n, "| mean aFRR %.0f | mean energy-side (gap - aFRR) %.0f | days with energy-side < 0: %d" %
+              (X[f"aFRR_{law}"].mean(), X[f"energy_side_{law}"].mean(), int((X[f"energy_side_{law}"] < 0).sum())))
+        if with_zero: print("   lambda_R=0 gap: max |gap0| = %.2e (identity P1==B2 when reserve revenue is zero)" % X[f"gap0_{law}"].abs().max())
+if __name__ == "__main__": main()
diff --git a/code/e_tests/e09_equal_cost_and_tost.py b/code/e_tests/e09_equal_cost_and_tost.py
new file mode 100644
index 0000000..b36e637
--- /dev/null
+++ b/code/e_tests/e09_equal_cost_and_tost.py
@@ -0,0 +1,38 @@
+"""E9 - (a) equal-cost calibration: rescale each law's coefficients so its B2 aging cost on a reference day equals a
+common target (default: the manuscript's 29.5 EUR/day); (b) TOST equivalence of the paired ReLCCA - throughput gap
+difference on the scan (results/E08_scan.csv) with margin +-delta EUR/day."""
+import argparse, numpy as np, pandas as pd
+from scipy import stats
+from common import *
+def aging_b2(pl, law, sc, real):
+    o = optimise(pl, sc, law, False); return -settle(pl, real, law, o["bid"])["Aging"]
+def calibrate(day, K, target, iters=4):
+    _, _, _, sc, real = load(day, K); base = plant(); sc_f = {}
+    for law in LAWS:
+        s = 1.0
+        for _ in range(iters):
+            pl = scaled(base, law, s); cost = aging_b2(pl, law, sc, real); s *= target / cost if cost > 0 else 1.0
+        sc_f[law] = s
+    return sc_f, (sc, real)
+def scaled(base, law, s):
+    if law == "thr": return plant(thr_cost=base.thr_cost*s)
+    if law == "xu": return plant(xu_m=tuple(np.array(base.xu_m)*s))
+    return plant(kappa_levels=tuple(np.array(base.kappa_levels)*s), gamma_charge_base=base.gamma_charge_base*s, gamma_discharge_base=base.gamma_discharge_base*s)
+def tost(d, delta, block=7, B=5000, seed=SEED):
+    d = np.asarray(d, float); d = d[~np.isnan(d)]; n = len(d)
+    t_lo = stats.ttest_1samp(d, -delta, alternative="greater"); t_hi = stats.ttest_1samp(d, delta, alternative="less")
+    rng = np.random.default_rng(seed); nb = int(np.ceil(n/block)); m = np.empty(B)
+    for b in range(B): m[b] = np.concatenate([d[s:s+block] for s in rng.integers(0, max(n-block+1, 1), nb)])[:n].mean()
+    ci90 = tuple(np.quantile(m, [0.05, 0.95]))
+    return dict(n=n, mean=d.mean(), p_tost=max(t_lo.pvalue, t_hi.pvalue), ci90_block=ci90, equivalent=bool(ci90[0] > -delta and ci90[1] < delta))
+def main(day="2026-05-01", K=30, target=29.5, delta=10.0):
+    s, (sc, real) = calibrate(day, K, target); print("scale factors", s); rows = []
+    for law in LAWS:
+        pl = scaled(plant(), law, s[law]); g, o = gap(pl, sc, real, law); rows.append(dict(law=law, scale=s[law], gap=g, aging_B2=-o["B2"]["Aging"]))
+    X = pd.DataFrame(rows); save(X, "E09_equal_cost"); print(X.round(2))
+    print("spread of gaps across laws after calibration: %.2f EUR" % (X.gap.max()-X.gap.min()))
+    try:
+        S = pd.read_csv("results/E08_scan.csv"); r = tost(S.gap_relcca - S.gap_thr, delta); print("TOST ReLCCA-thr, margin +-%g:" % delta, r)
+        pd.DataFrame([r]).to_csv("results/E09_tost.csv", index=False)
+    except FileNotFoundError: print("run e08 first for the TOST part")
+if __name__ == "__main__": main()
diff --git a/code/e_tests/e10_reserve_price_robustness.py b/code/e_tests/e10_reserve_price_robustness.py
new file mode 100644
index 0000000..c65ae1f
--- /dev/null
+++ b/code/e_tests/e10_reserve_price_robustness.py
@@ -0,0 +1,22 @@
+"""E10 - replace the six fixed blog block means. (i) --auction_csv: user-supplied regelleistung.net aFRR capacity
+results, columns: date (YYYY-MM-DD), block (1-6), pos_eur_mw_h, neg_eur_mw_h; the day's prices replace the fixed ones.
+(ii) fallback: scale both price vectors by {0.5,0.75,1,1.25,1.5}. (The sandbox cannot reach regelleistung.net.)"""
+import argparse, numpy as np, pandas as pd
+from common import *
+class prices:
+    def __init__(s, up, dn): s.up, s.dn = np.asarray(up, float), np.asarray(dn, float)
+    def __enter__(s): s.old = core.reserve_prices; core.reserve_prices = lambda: (s.up, s.dn)
+    def __exit__(s, *a): core.reserve_prices = s.old
+def main(day="2026-05-01", K=30, auction_csv=None, factors=(0.5, 0.75, 1, 1.25, 1.5)):
+    _, _, _, sc, real = load(day, K); pl = plant(); up0, dn0 = core.reserve_prices(); rows = []
+    if auction_csv:
+        A = pd.read_csv(auction_csv); A = A[A.date == day].sort_values("block")
+        assert len(A) == 6, "need six 4-h blocks for the day"
+        with prices(np.repeat(A.pos_eur_mw_h, 4), np.repeat(A.neg_eur_mw_h, 4)):
+            for law in LAWS: rows.append(dict(case="auction", law=law, gap=gap(pl, sc, real, law)[0]))
+    for f in factors:
+        with prices(up0*f, dn0*f):
+            for law in LAWS: rows.append(dict(case=f"x{f}", law=law, gap=gap(pl, sc, real, law)[0]))
+    X = pd.DataFrame(rows); save(X, "E10_reserve_prices"); print(X.pivot_table(index="case", columns="law", values="gap").round(1))
+if __name__ == "__main__":
+    p = argparse.ArgumentParser(); p.add_argument("--auction_csv"); a = p.parse_args(); main(auction_csv=a.auction_csv)
